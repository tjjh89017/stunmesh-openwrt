# stunmesh-agent configuration (UCI). See docs/quick-start.md and
# contrib/openwrt/README.md in the stunmesh-provisioner repo.
#
# Leaving namespace/node_id/controller_pubkey blank is fine -- the
# daemon just logs once and does not start until they're set.
#
# Setup, once per node:
#   1. stunmesh-agent keygen
#      (writes /etc/stunmesh/agent/identity.key and prints its
#      public key)
#   2. Send the printed public key to the controller operator; they run
#      `stunmesh-provd node add <namespace> <node_id>` and send back
#      NAMESPACE, NODE_ID, CONTROLLER_PUBKEY.
#   3. Fill in the values below, then:
#        /etc/init.d/stunmesh-agent enable
#        /etc/init.d/stunmesh-agent start
#
# identity_key is a path only -- the key itself never goes here.
#
# stunmesh-agent is a daemon (procd, respawned): it fetches, decrypts,
# checks, and applies once at start, then ticks on refresh_interval
# and full_apply_interval below. There is no cron integration.

config stunmesh-agent 'main'
	option namespace            ''
	option node_id              ''
	option controller_pubkey    ''
	option refresh_interval     '5m'
	option full_apply_interval  '24h'
	option identity_key         '/etc/stunmesh/agent/identity.key'
	option last                 '/etc/stunmesh/agent/last.json'
	option lock                 '/var/lock/stunmesh-agent.lock'
	# option use_plugin         'dhtproxy'

# use_plugin left unset above -- the built-in default dhtproxy backend
# and proxy list apply. Uncomment use_plugin and this section to pin a
# custom proxy list instead:
#
# config stunmesh-agent-plugin 'dhtproxy'
#	option type    'dhtproxy'
#	list   proxies 'https://dhtproxy2.jami.net'
#	list   proxies 'https://dhtproxy3.jami.net'
