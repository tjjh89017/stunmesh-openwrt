# stunmesh-agent configuration (UCI). See docs/quick-start.md.
#
# Leaving namespace/node_id/controller_pubkey/private_key_file blank is
# fine -- the agent just logs once and does nothing until they're set.
#
# Setup, once per node:
#   1. stunmesh-agent keygen --identity-key /etc/stunmesh/provd/identity.key
#   2. Send the printed public key to the controller operator; they run
#      `stunmesh-provd node add <namespace> <node_id>` and send back
#      NAMESPACE, NODE_ID, CONTROLLER_PUBKEY, DHT_PROXY.
#   3. Fill in the values below, then:
#        /etc/init.d/stunmesh-agent enable
#        /etc/init.d/stunmesh-agent start
#
# private_key_file is a path only -- the key itself never goes here.

config stunmesh-agent 'main'
	option namespace          ''
	option node_id            ''
	option controller_pubkey  ''
	list   proxy              'https://dhtproxy2.jami.net'
	list   proxy              'https://dhtproxy3.jami.net'
	option private_key_file   '/etc/stunmesh/provd/identity.key'
	# Optional; dhtproxy is the only backend and already the default.
	option backend            'dhtproxy'
	option boot_delay         '15'
	option fetch_interval     '5'
	option lock_file          '/var/lock/stunmesh-agent.lock'
