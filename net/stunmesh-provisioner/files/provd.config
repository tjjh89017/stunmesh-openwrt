# stunmesh-agent configuration (UCI). Reference: stunmesh-provisioner's
# contrib/openwrt/README.md and docs/quick-start.md.
#
# This node has no identity or namespace assigned yet. Until namespace,
# node_id, controller_pubkey, and private_key_file are all set below,
# /etc/init.d/stunmesh-agent and the WAN hotplug trigger both log one line
# ("incomplete /etc/config/provd ...") and do nothing -- this is the normal
# state of a freshly flashed node, not an error.
#
# Setup, once per node:
#   1. Generate this node's identity key:
#        stunmesh-agent keygen --identity-key /etc/stunmesh/provd/identity.key
#      This prints the node's identity public key and writes the private
#      key to /etc/stunmesh/provd/identity.key at mode 0600.
#   2. Send the printed public key to the controller operator, who runs
#      `stunmesh-provd node add <namespace> <node_id>` on the controller and
#      sends back NAMESPACE, NODE_ID, CONTROLLER_PUBKEY, and DHT_PROXY.
#   3. Fill in namespace/node_id/controller_pubkey/proxy below with those
#      values, then:
#        /etc/init.d/stunmesh-agent enable
#        /etc/init.d/stunmesh-agent start
#
# private_key_file is only a path; the private key material itself never
# goes in this file.

config provd 'main'
	option namespace          ''
	option node_id            ''
	option controller_pubkey  ''
	list   proxy              'https://dhtproxy2.jami.net'
	list   proxy              'https://dhtproxy3.jami.net'
	option private_key_file   '/etc/stunmesh/provd/identity.key'
	# backend is optional. dhtproxy is the only type and the agent's
	# own default; the proxy list above belongs to it.
	option backend            'dhtproxy'
	option boot_delay         '15'
	option fetch_interval     '5'
	option lock_file          '/var/lock/stunmesh-agent.lock'
