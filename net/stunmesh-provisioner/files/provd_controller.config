# stunmesh-provd (controller) configuration (UCI).
#
# stunmesh-provd is the *controller*: it holds every node's tunnel and
# identity keys and publishes their encrypted bundles to the DHT.
# Upstream's own docs (stunmesh-provisioner's contrib/systemd/README.md)
# say the controller "is a normal Linux machine, not an OpenWrt router"
# and ship no OpenWrt integration for it. This package exists for anyone
# who wants to run it on a router anyway; whether that is a good idea on
# your hardware (flash wear from the state tree below, a secrets-holding
# daemon sharing the device it provisions) is your call, not something
# this package decides for you.
#
# The service does nothing until the tree at "dir" has been provisioned
# with at least one namespace:
#   stunmesh-provd --dir <dir> init <namespace>
#   stunmesh-provd --dir <dir> node add <namespace> <node_id>
# See stunmesh-provisioner's docs/quick-start.md for the full walkthrough
# (wg.yaml, stunmesh.yaml, the key exchange with each node).
#
# This package installs the service disabled. Once the tree above is
# provisioned:
#   /etc/init.d/stunmesh-provd enable
#   /etc/init.d/stunmesh-provd start

config provd_controller 'main'
	# Root of the provisioning tree. Must already exist -- created by
	# `stunmesh-provd init`, above -- or the service refuses to start.
	option dir       '/etc/stunmesh/provd'

	# Restrict publishing to one namespace. Leave empty to publish every
	# namespace under "dir" each round (the common case, and what
	# `stunmesh-provd publish` itself defaults to).
	option namespace ''
