# stunmesh-provd (controller) configuration (UCI). See docs/quick-start.md.
#
# It holds every node's tunnel and identity keys; running it on a router
# (flash wear, co-locating secrets with what it provisions) is your call.
#
# Setup:
#   stunmesh-provd --dir <dir> init <namespace>
#   stunmesh-provd --dir <dir> node add <namespace> <node_id>
# Then:
#   /etc/init.d/stunmesh-provd enable
#   /etc/init.d/stunmesh-provd start

config stunmesh-provd 'main'
	# Must already exist -- created by `stunmesh-provd init` above.
	option dir       '/etc/stunmesh/provd'

	# Empty publishes every namespace under "dir" each round (default).
	option namespace ''
